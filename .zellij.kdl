layout {
    pane {
      split_direction "vertical"
      pane name="data-fair" borderless=true {
        command "bash"
        args "-ic" "nvm use && bash"
      }
      pane name="deps" {
        command "bash"
        args "-ic" "npm run dev-deps"
      }
      pane name="mock" {
        command "bash"
        args "-ic" "npm run dev-mock"
      }
    }
    pane {
      split_direction "vertical"
      pane name="ui" {
        command "bash"
        args "-ic" "nvm use && npm -w ui run dev"
      }
      pane name="api" {
        command "bash"
        args "-ic" "nvm use && npm run dev-api"
      }
      // Optional: only the simulations (/agents-sim) need it. Idle it costs
      // nothing, and having it already up is what keeps the skill's bridge
      // check from being the thing that stops a run.
      pane name="bridge" {
        command "bash"
        args "-ic" "nvm use && npm run dev-bridge"
      }
    }
    pane size=1 borderless=true {
        command "bash"
        args "-ic" "echo -n -e \"Dev server available at \\e[1;96mhttp://$DEV_HOST:$NGINX_PORT1\\033[0m\""
    }
}