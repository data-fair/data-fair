{
  "kinds": {
    "prose": "the terms are in title/summary/description/keywords today — a control group",
    "stopwords": "natural French phrasing with articles/prepositions — tests the index language",
    "stemming": "singular/plural or derivation differs from the prose — tests the stemmer",
    "colText": "the terms only appear in column titles/descriptions — tests _searchText(schema labels)",
    "enum": "the terms only appear in enum values — tests _searchText(enums); precision cases have a 'trap' the enum could pull in",
    "gap": "the terms appear nowhere in any existing content — only shadow content / a thesaurus can solve these"
  },
  "catalogs": {
    "opendata.koumoul.com": [
      { "q": "radars fixes", "kind": "prose", "expect": ["liste-des-radars-fixes-en-france"] },
      { "q": "prix des carburants", "kind": "prose", "expect": ["prix-des-carburants-par-station"] },
