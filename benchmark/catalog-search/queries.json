      { "q": "fauteuil roulant", "kind": "colText", "expect": ["accessibilite-des-etablissements-recevant-du-public-erp-pour-les-personnes-en-situation-de-handicap"] },
      { "q": "pharmacie", "kind": "colText", "expect": ["annuaire-sante-ameli"] },
