      { "q": "solaire", "kind": "enum", "expect": ["registre-national-installation-production-stockage-electricite-agrege-311225", "prod", "production-electrique-par-filiere-a-la-maille-commune"], "note": "prose says photovoltaïque; enums carry Solaire on 13 datasets" },
      { "q": "panne", "kind": "gap", "expect": ["frequence-moyenne-de-coupure-par-client-bt", "duree-moyenne-de-coupure-bt"] },
      { "q": "haute tension", "kind": "gap", "expect": ["reseau-hta", "reseau-souterrain-hta"], "note": "prose says HTA / moyenne tension" },
