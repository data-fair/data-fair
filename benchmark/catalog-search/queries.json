      { "q": "voiture électrique", "kind": "enum", "expect": ["tvv-leasing-social-2026", "bonus-ecologique-score-environnemental"], "note": "prose says voitures particulières électriques; the enum of enquete-mobilite-jeunes is the trap" },
      { "q": "passoire thermique", "kind": "gap", "expect": ["dpe03existant", "dpe-france"] },
