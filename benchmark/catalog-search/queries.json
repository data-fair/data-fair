      { "q": "le nombre de points de charge par département", "kind": "stopwords", "expect": ["nombre-de-points-de-charge-accessibles-au-public-pour-100-000-habitants-par-dept", "puissance-moyenne-installee-par-point-de-charge-par-dept-et-son-evolution-sur"] },
