      { "q": "bac S", "kind": "enum", "expect": ["resultats-baccalaureat-etablissement"], "note": "also in prose; enums of census datasets are the trap" },
      { "q": "élections", "kind": "gap", "expect": ["contours-des-bureaux-de-vote", "contours-circonscriptions-legislatives"] },
