{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "paths": {
      // same alias as ui/tsconfig.json — needed when a test imports a ui module
      // (the ui package "imports" target crosses package boundaries, which
      // NodeNext resolution rejects)
      "#api/types": ["./api/types/index.ts"],
      // api runs content-disposition 1 (untyped, in api/node_modules) while express 5.3 hoists
      // its own v2 (typed, different API) to the root: without this, tsc checks against v2
      "content-disposition": ["./node_modules/@types/content-disposition/index.d.ts"]
    }
  },
  "exclude": [
    "node_modules",
    "types",
    "data",
    "parquet_writer",
    "ui",
    "test-it",
    "tmp"
  ]
}