{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "paths": {
      // same alias as ui/tsconfig.json — needed when a test imports a ui module
      // (the ui package "imports" target crosses package boundaries, which
      // NodeNext resolution rejects)
      "#api/types": ["./api/types/index.ts"]
    }
  },
  "exclude": [
    "node_modules",
    "types",
    "data",
    "parquet_writer",
    "ui",
    "test-it",
    "tmp",
    // deliberately odd, standalone JS snippets: they are the INPUT DATA of the capabilities-usage
    // scanner's self-test (dev/spikes/indexing-rework/scan-capabilities-usage.ts), not code we run
    // or maintain. Type-checking them would only pressure us to change the test data.
    "dev/spikes/indexing-rework/scan-test-fixture"
  ]
}