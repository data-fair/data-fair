# Defaults of the dev environment: fixed ports, no tooling needed.
# `npm run dev-deps` copies this file to .env when there is none; .env overrides it
# (it is never overwritten, edit it freely, for example to raise the elasticsearch heap).
# Ports stay in 5600-5649 so that they rarely collide with other local services.
DEV_HOST=localhost
SSRF_PUBLIC_IPS=127.0.0.1,::1
NGINX_PORT=5600
NGINX_PORT2=5601
DEV_API_PORT=5602
DEV_UI_PORT=5603
DEV_OBSERVER_PORT=5604
DEV_UI_HMR_PORT=5605
ES_PORT=5606
MONGO_PORT=5607
S3_PORT=5608
MAILDEV_UI_PORT=5609
MAILDEV_SMTP_PORT=5610
CLAMAV_PORT=5611
SD_PORT=5612
EVENTS_PORT=5613
OAV_PORT=5614
CAPTURE_PORT=5615
CATALOGS_PORT=5616
MOCK_PORT=5617
AGENTS_PORT=5618
REGISTRY_PORT=5619
BRIDGE_PORT=5620
MCP_PORT=5621
